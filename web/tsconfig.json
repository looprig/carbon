{
  // The browser half of the project: everything under `src`. It emits nothing,
  // so unlike the packages there is no `rootDir`/`declaration` constraint and
  // `paths` may point straight at the sibling workspace sources.
  //
  // `vite.config.ts` and its test are NOT here. They run in node, and the only
  // way to give them node's globals without also handing them to browser code
  // is a second program — see tsconfig.node.json. Project `references` cannot
  // do it: a referenced project may not set `noEmit`, and this app has nothing
  // to emit.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "@vitest/browser-playwright"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true
    // Mirrors vite.config.ts's resolve.alias so the type checker and the
    // bundler agree on where @looprig/client lives. Without it, tsc resolves
    // the package `exports` to ./dist/index.d.ts, which a fresh checkout has
    // not built.

  },
  "include": ["src"]
}
